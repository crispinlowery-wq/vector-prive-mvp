POSTGRES_DB=vector
POSTGRES_USER=vector
POSTGRES_PASSWORD=change-me

WEB_PORT=3000
API_PORT=8000
WEB_BASE_URL=https://app.vectorprive.com
NEXT_PUBLIC_API_URL=https://api.vectorprive.com
CORS_ORIGINS=https://app.vectorprive.com,http://localhost:3000,http://127.0.0.1:3000

# Managed identity (Auth0, Clerk, Entra External ID, etc.)
OIDC_ISSUER=https://your-identity-provider.example.com/
OIDC_AUDIENCE=https://api.vectorprive.example.com
OIDC_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json
INITIAL_ADMIN_SUBJECT=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=Vector Privé Administrator

# Auth0 web session (server-only except the public application client ID)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=https://api.vectorprive.com
APP_BASE_URL=https://app.vectorprive.com

# Hotel connectivity. Keep live booking disabled until Nuitee sandbox sign-off.
PARTNER_PROVIDER=nuitee
PARTNER_BOOKING_ENABLED=false
NUITEE_API_KEY=
NUITEE_SEARCH_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOKING_BASE_URL=https://book.liteapi.travel/v3.0

# Operator research only. It cannot book, contact suppliers or spend.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_ENABLED=true
OPENAI_RESEARCH_MAX_TOOL_CALLS=4
OPENAI_RESEARCH_TIMEOUT_SECONDS=45
OPENAI_RESEARCH_DAILY_LIMIT=10
EMAIL_PROVIDER=placeholder
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
STRIPE_SECRET_KEY=
